{
  "buildCommand": "bash build.sh",
  "outputDirectory": "build/web",
  "cleanUrls": false,
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/demos/:path*",
      "destination": "/demos/:path*"
    },
    {
      "source": "/((?!demos/).*)",
      "destination": "/index.html"
    }
  ]
}
